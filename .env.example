# Supabase Dashboard -> Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase Dashboard -> Project Settings -> API Keys -> Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_KEY

# Supabase Dashboard -> Project Settings -> API Keys -> Secret key
# Server-only: never use NEXT_PUBLIC_ in this variable name.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_WITH_YOUR_KEY

# Random secret of at least 32 characters used to sign application sessions.
AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Calendly (fase 2 — webhooks / API)
# CALENDLY_WEBHOOK_SIGNING_KEY=
# CALENDLY_API_TOKEN=

# Zoom OAuth (fase 2 — creación automática de aulas)
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_MOCK_JOIN_URL=
# ZOOM_MOCK_PASSWORD=

# URL pública del sitio (CTAs de correo). Preferir dominio propio, no staging.
# PUBLIC_SITE_URL=https://tudominio.com
# NEXT_PUBLIC_SITE_URL=https://tudominio.com

# Resend — envío de correos desde el servidor (nunca exponer en el frontend)
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY=re_REPLACE_WITH_YOUR_KEY
# Alias opcional: EMAIL_API_KEY=
# Sin dominio verificado usa onboarding@resend.dev (solo envía al correo de la cuenta Resend).
# Con dominio verificado: A-Inman Languages <xavier.y@example.org>
RESEND_FROM=A-Inman Languages <beth.t@example.com>
# Alias opcional del remitente centralizado:
# EMAIL_FROM="A-Inman Languages <noreply@dominio.com>"
CONTACT_INBOX_EMAIL=ainman.languages@gmail.com
